{
  "name": "QR Scanner",
  "short_name": "QR Scanner",
  "version": "1.0.0",
  "description": "Simple QR code scanner and generator",
  "scope": "/",
  "start_url": "/index.html",
  "background_color": "#ffffff",
  "theme_color": "#4a90d9",
  "display": "standalone",
  "icons": [
    {
      "src": "icon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
